    }
  ],
  "contributors": [
    {
      "title": "Fabio Fogliarini Brolesi",
      "role": "author"
    }
  ],
  "sources": [
    {
      "title": "TACO 4ª edição, NEPA/UNICAMP"
    },
    {
      "title": "POF 2008-2009, Tabela de Medidas Referidas, IBGE"
    }
